[gd_scene format=3 uid="uid://5o6binxdjwg5"]

[sub_resource type="GDScript" id="GDScript_gv43q"]
script/source = "extends CanvasLayer 
@onready var color_rect: ColorRect = $ColorRect 
func fade_to_death_screen() -> void: 
	color_rect.modulate.a = 0.0 
	var tween = create_tween()
	tween.tween_property(color_rect, \"modulate:a\", 1.0, 1.0)
	await tween.finished 
	get_tree().change_scene_to_file( \"res://scenes/death_screen.tscn\" )
"

[node name="CanvasLayer" type="CanvasLayer" unique_id=1934845576]
script = SubResource("GDScript_gv43q")

